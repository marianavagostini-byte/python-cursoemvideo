from time import sleep

def li():
    print('-='*30)


def contador(i,f,p):
    if p ==0:
        p=1
    p = abs(p)
    li()
    print(f'Contagem de {i} ate {f} de {p} em {p}..')
    sleep(0.5)
    li()
    if i < f:
        f+=1
    else:
        f= f-1
        p= -p

    for cada in range(i,f,p):
        print(f' {cada} ',end='')
    print( 'FIM !')
        
contador(1,10,1)
contador(10,0,2)
print('Agora e a sua vez de personalizar a contagem !')
inicio=int(input('Inicio: '))
fim=int(input('Fim: '))
passo=int(input('Passo: '))
li()
contador(inicio,fim,passo)