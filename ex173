turma=list()

def media(*n):
    return sum(n)/len(n)

def cadastra(lista):
    while True:
        dados={}
        notas=[]
        dados['nome']=input('Nome: ')
        for n in range(1,4):
            notas.append(float(input(f'{n}ª nota: ')))
        dados['notas']=notas[:]
        dados['media']=media(*notas)
        lista.append(dados)
        resp=input('Deseja continuar? [S/N]')
        if resp.upper()=='N':
            break

def boletim(lista):
    for p in lista:
        print(f'{p["nome"]} - {p["notas"]} - {p["media"]:.2f}')

def aprovados(lista):
    nomes=[]
    for p in lista:
        if p['media'] >=7:
            nomes.append(p['nome'])
    return nomes

cadastra(turma)
boletim(turma)
print(f'Aprovados: {aprovados(turma)}')

medias=[]
for p in turma:
    medias.append(p['media'])
print(f'Media geral: {media(*medias):.2f}')