from operator import itemgetter
dicionario={}
for c in range(1,6):
    nome=input('Nome: ')
    dicionario[nome]=float(input(f'Qual a nota de {nome}? '))

print('-=-=-= NOTAS DA TURMA -=-=-=')
for k,v in dicionario.items():
    print(f' {k} - {v}')
print('-=-=-= RANKING -=-=-=')
ranking=sorted(dicionario.items(), key=itemgetter(1),reverse=True)
for i,v in enumerate(ranking):
    print(f' {i+1}º {v[0]} - {v[1]}. ')
print()
media=sum(dicionario.values())/( len(dicionario))
print(f'O melhor da turma: {ranking[0][0]} - {ranking[0][1]}')
print(f'Ultimo colocado: {ranking[-1][0]} - {ranking[-1][1]}')
print(f'Media da turma: {media}')
print('-=-=-= ORDEM ALFABETICA -=-=-=-=')
alfabetica=sorted(dicionario.items(),key=itemgetter(0))
for k,v in alfabetica:
    print(f'{k} - {v}')