def fatorial(num, show=False):
    f = 1
    if show:
        print(f'{num}! = ', end='')
    for c in range(num, 0, -1):
        if show:
            print(f'{c}', end='')
            if c > 1:
                print(' x ', end='')
            else:
                print(' = ', end='')
        f *= c
    return f


print(fatorial(5))
print(fatorial(5, show=True))
print(fatorial(4, True))