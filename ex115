temporaria = []
principal = []
maior = 0
menor = 0

while True:
    temporaria.append(str(input('Nome: ')))
    while True:
        try:
            nota = float(input('Nota de 0 a 10: '))
        except ValueError:
            print('Erro! Digite um numero.')
            continue
        if nota < 0 or nota > 10:
            print('Invalido! Digite entre 0 e 10.')
            continue
        break
    temporaria.append(nota)
    if len(principal) == 0:
        maior = menor = temporaria[1]
    else:
        if temporaria[1] > maior:
            maior = temporaria[1]
        if temporaria[1] < menor:
            menor = temporaria[1]
    principal.append(temporaria[:])
    temporaria.clear()
    resp = str(input('Deseja continuar? [S/N] ')).strip()
    if resp.upper() == 'N':
        break

if len(principal) == 0:
    print('Nenhum aluno foi cadastrado.')
else:
    print(f'Foram cadastrados: {len(principal)} alunos.')
    for p in principal:
        print(f'  {p[0]} - nota: {p[1]}')
    print(f'Maior nota ({maior}): ', end='')
    for p in principal:
        if p[1] == maior:
            print(f'[{p[0]}] ', end='')
    print()
    print(f'Menor nota ({menor}): ', end='')
    for p in principal:
        if p[1] == menor:
            print(f'[{p[0]}] ', end='')
    print()
    