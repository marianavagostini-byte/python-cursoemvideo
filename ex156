galera=[]
soma=media=0
mulheres=[]

while True:
    dados={}
    dados['nome']=str(input('Nome: '))
    while True:
        dados['sexo']=input('Sexo [F/M]: ').upper()
        if dados['sexo'] in'FM':
            break
        print('ERRO! Digite apenas M ou F .')
    
    dados['idade']=int(input('Idade: '))
    soma+=dados['idade']
    galera.append(dados)
    while True:
        resp=input('Deseja continuar? [S/N]')
        if resp.upper() in 'SN':
            break
        print('ERRO! Responda apenas com S ou N.')
    if resp.upper()=='N':
            break
            
   
media=soma / len(galera)

print(f'Foram cadastradas: {len(galera)} pessoas.')
print(f'Media de idade: {media} anos.')
print('As mulheres cadastradas foram: ',end='')
for p in galera:
     if p['sexo']=='F':
          mulheres.append(p['nome'])
print(f' {mulheres}')
print('Lista de pessoas que estao acima da media: ',end='')
for p in galera:
     if p['idade'] >= media:
          print(f'{p["nome"]} - {p["idade"]} anos.')