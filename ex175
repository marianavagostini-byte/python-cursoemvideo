pacientes=list()

def imc(peso,altura):
    return peso/(altura**2)

def cadastro(lista):
    while True:
        dados={}
        peso=[]
        altura=[]
        dados['nome']=input('Nome: ')
        dados['idade']=int(input('idade: '))
        peso.append(float(input('Peso: ')))
        altura.append(float(input('Altura: ')))
        dados['peso']=peso[:]
        dados['altura']=altura[:]
        lista.append(dados)
        resp=input('Deseja continuar? [S/N]')
        if resp.upper()=='N':
            break

def pontuario(lista):
    print('PRONTUARIO')
    for p in lista:
        print(f'{p["nome"]}.........{p["idade"]}anos   {p["peso"]}kg  {p['altura']}m | IMC {imc}')


def atencao(lista):
    acima=[]
    for p in lista:
        if p['imc'] > 30:
            acima.append(p['nome'])
    return acima

cadastro(pacientes)
pontuario(pacientes)
print(f'Pacientes que precisam de atencao: {atencao(pacientes)}')
idades = []
for p in pacientes:
    idades.append(p['idade'])
print(f'Idade media dos pacientes: {sum(idades) / len(idades):.2f} anos') 