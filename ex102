usuarios=[]
while True:
    nome=input('Digite um usuario: ')
    if nome not in usuarios:
            usuarios.append(nome)
    else:
         print('Nome ja foi digitado, digite outro usuario..')
    resp=input('Deseja continuar [S/N] ? ').upper().strip()
    if resp == 'N':
        break
usuarios.sort()
print(f'Os usuarios digitados foram: {usuarios}')