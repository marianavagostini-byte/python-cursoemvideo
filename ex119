from random import randint
print('-=-=-=-=-=-= JOGO MEGACENA -=-=-=-=-=-=')
jogos = int(input('Quantos jogos? '))
caderno = []
for j in range(jogos):
    jogo = []
    while len(jogo) < 6:
        num = randint(1, 60)
        if num not in jogo:
            jogo.append(num)
    jogo.sort()
    caderno.append(jogo)
for c in range(len(caderno)):
    print(f'Jogo {c+1}: {caderno[c]}')