ficha = []
while True:
    nome = input('Nome: ')
    nota1 = float(input('Nota 1: '))
    nota2 = float(input('Nota 2: '))
    media = (nota1 + nota2) / 2
    ficha.append([nome, [nota1, nota2], media])
    resp = input('Continuar? [S/N] ')
    if resp.upper() == 'N':
        break
print('--- BOLETIM ---')
for c in range(len(ficha)):
    print(f'{c} - {ficha[c][0]} - Media: {ficha[c][2]}')
while True:
    opc = int(input('Qual aluno? (999 sair): '))
    if opc == 999:
        break
    print(f'Nome: {ficha[opc][0]}')
    print(f'Notas: {ficha[opc][1]}')
    print(f'Media: {ficha[opc][2]}') 