lista=[]
soma=media=0
while True:
    dados={}
    dados['nome']=str(input('Nome: '))
    while True:
        dados['sexo']=input('Sexo [M/F]: ').upper()[0]
        if dados['sexo'] in 'MF':
            break
        print('ERRO! ')
    dados['idade']=int(input('Idade: '))
    soma+=dados['idade']
    lista.append(dados)
    while True:
        resp=input('Quer continuar? [S/N]').upper()[0]
        if resp in 'SN':
            break
        print('ERRO')
    if resp in 'N':
        break
media=soma/len(lista)
print(f'Foram cadastradas {len(lista)} pessoas.')
print(f'A media de idade e {media} anos.')
for p in lista:
    if p['sexo'] =='F':
        print(f'As mulheres sao: {p["nome"]}.')
for p in lista:
    if p['idade']>=media:
        print(f'Idades acima da media: {p["nome"]} -> {p["idade"]}')