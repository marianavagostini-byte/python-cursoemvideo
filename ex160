lista=[]
soma=media=0
while True:
    dados={}
    dados['nome']=input('Nome: ')
    while True:
        dados['tipo']=input('Tipo sanguineo [A/B/O/AB]: ').upper()
        if dados['tipo'] in ['A', 'B', 'O', 'AB']:
            break
        print('ERRO!')
    dados['idade']=int(input('idade: '))
    soma+=dados['idade']
    lista.append(dados)
    while True:
        resp=input('Deseja continuar? [S/N]').upper()[0]
        if resp in 'SN':
            break
        print('ERRO!')
    if resp == 'N':
        break
media=soma/len(lista)
print(f'Foram cadastrados {len(lista)} pacientes.')
print(f'A media de idade: {media} anos.')
for p in lista:
    if p['tipo'] == 'O':
        print(f'{p["nome"]} - tipo: {p["tipo"]}')
print('Pacientes acima da media: ',end='')
for p in lista:
    if p['idade']>=media:
        print(f'{p["nome"]} - {p["idade"]} anos.')
